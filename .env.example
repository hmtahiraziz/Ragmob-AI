# FastAPI backend (must include /api prefix)
# Dev:  http://localhost:8000/api
# Prod: https://api.your-domain.com/api  (HTTPS required in release)
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Clerk — use pk_test_ locally; pk_live_ is required for release/EAS production
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...



# Optional: reserved for a future EAS + Sentry setup (Expo Go uses in-app ErrorBoundary only)
EXPO_PUBLIC_SENTRY_DSN=

# Backend checklist before publish:
# - AUTH_DISABLED=false on the API
# - Clerk JWT verification enabled against the same Clerk app
# - Production Gemini / model keys with quota monitoring
# - Chat image: CHAT_IMAGE_MAX_MB, CHAT_IMAGE_MAX_DIMENSION,
#   CHAT_IMAGE_CONTEXT_TTL_SECONDS (+ optional CHAT_IMAGE_CONTEXT_DIR),
#   CHAT_HISTORY_LIMIT — see AI web kit
#   backend/docs/ragmob-chat-image-context.md (follow-up image strategy)
# - Vision contract: POST /api/chat/images → imageId, then POST /api/chat/stream
#   with imageId (text-only JSON unchanged). See AI web kit
#   backend/docs/ragmob-chat-image-contract.md
