{
  "expo": {
    "name": "Ragmob",
    "slug": "ragmob",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ragmob",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ragmob.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Ragmob uses the camera so you can take a photo and ask the assistant about it.",
        "NSPhotoLibraryUsageDescription": "Ragmob uses your photo library so you can attach an image and ask the assistant about it.",
        "NSMicrophoneUsageDescription": "Ragmob uses the microphone so you can dictate messages to the assistant.",
        "NSSpeechRecognitionUsageDescription": "Ragmob converts your speech to text so you can edit and send it as a chat message."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ragmob.app",
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F2",
          "dark": {
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ragmob to access your photos so you can ask about an image.",
          "cameraPermission": "Allow Ragmob to use the camera so you can take a photo and ask about it."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Ragmob to use the microphone so you can dictate messages.",
          "speechRecognitionPermission": "Allow Ragmob to convert speech to text for chat messages.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3471209b-0025-416a-95e8-f7bc4f639602"
      }
    },
    "owner": "technology726"
  }
}
